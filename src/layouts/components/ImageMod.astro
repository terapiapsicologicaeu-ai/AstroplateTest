---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// Props interface for the component
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
  class?: string;
  style?: any;
}

// Destructuring Astro.props to get the component's props
let {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  format,
  style,
  fit,
} = Astro.props;

// External images (http/https) are rendered as-is with a normal <img>.
const isExternal = /^https?:\/\//i.test(src);

// Normalize local image paths coming from the CMS:
// "/images/foo.jpg", "images/foo.jpg" and "public/images/foo.jpg"
// all resolve to "/images/foo.jpg".
let localSrc = src.replace(/^\/?public\//, "/");
if (!localSrc.startsWith("/")) localSrc = `/${localSrc}`;

// Glob pattern to load images from the /public/images folder
const images = import.meta.glob(
  "/public/images/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
);

// Check if the source path is valid
const globKey = `/public${localSrc}`;
const isValidPath = !isExternal && images[globKey] ? true : false;

// Log a warning message in red if the image is not found
!isExternal &&
  !isValidPath &&
  console.error(
    `\x1b[31mImage not found - ${src}.\x1b[0m Make sure the image is in the /public/images folder.`,
  );
---

{
  isExternal ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding={decoding}
      class={className}
      style={style}
    />
  ) : (
    isValidPath && (
      <Image
        src={images[globKey]() as Promise<{ default: ImageMetadata }>}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fit={fit ? fit : "contain"}
        decoding={decoding}
        class={className}
        format={format}
        style={style}
      />
    )
  )
}
